{"ts": "2026-11-25T19:08:37+00:00", "run_id": "20261125T190829Z", "stage": "narration", "shot": "s02", "provider": "gemini", "model": "gemini-3.8-flash-tts", "params": {"text": "My mother roasts the beans, and the smoke calls the neighbors in.", "voice": "Achird", "style": "warm, calm and unhurried, a young man remembering"}, "seed": null, "attempt": 1, "status": "ok", "latency_s": 3.459, "cost_usd": 0.0, "output_bytes": 239548, "usage": {"initial_input_tokens": 16, "input_tokens_by_modality": [{"modality": "text", "tokens": 16}], "output_tokens_by_modality": [{"modality": "audio", "tokens": 121}], "total_cached_tokens": 0, "total_input_tokens": 16, "total_output_tokens": 121, "total_thought_tokens": 0, "total_tokens": 137, "total_tool_use_tokens": 0}}
